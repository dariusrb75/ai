<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is required even though no traffic leaves the phone: Android gates all socket
      creation behind it, including a server socket bound to the local hotspot.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeps the server alive while the screen is off or the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ requires this to show the ongoing-notification the service needs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineChess"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic: the whole point is plain HTTP on a private hotspot with no
          internet. There is no certificate authority to trust out here, and HTTPS with a
          self-signed cert would make the iPhone refuse to load the page at all.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ChessHostService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
